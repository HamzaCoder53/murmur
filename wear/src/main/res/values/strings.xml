    <!-- How it works -->
    <string name="help_title">How it works</string>
    <string name="help_nearby_title">Chat nearby</string>
    <string name="help_nearby_body">No account or phone number. Messages go phone to phone and watch to watch over Bluetooth, hopping through up to 7 devices. Works with Bitchat users too.</string>
    <string name="help_public_title">Public and private</string>
    <string name="help_public_body">The main chat is public to everyone nearby. Tap a name to message privately: private chats are encrypted end to end.</string>
    <string name="help_phone_title">With your phone</string>
    <string name="help_phone_body">With Skein open on your phone, the watch turns its own radio off and sends through the phone. People → Link shows Phone.</string>
    <string name="help_link_title">Link to phone</string>
    <string name="help_link_body">Menu → Link to phone gives the watch your phone\'s identity: one inbox on both, same name, photos and read status in sync. Confirm on the phone.</string>
    <string name="help_alone_title">On its own</string>
    <string name="help_alone_body">Away from the phone the watch uses its own Bluetooth, scanning briefly each minute to save battery. People → Link shows Own radio.</string>
    <string name="help_favorites_title">Favorites</string>
    <string name="help_favorites_body">In a chat, tap the name at the top, then Favorite. When you both favorite each other (Mutual) you can message over the internet when far apart.</string>
    <string name="help_internet_title">Internet messages</string>
    <string name="help_internet_body">For mutual favorites out of Bluetooth range, messages go over the internet through public Nostr relays. They are encrypted: relays can\'t read them.</string>
    <string name="help_frequency_title">How often</string>
    <string name="help_frequency_body">Menu → Internet DMs: Off, 5 min, 1 min or Always on. While you chat and on the charger it stays connected, and it checks when you wake the watch.</string>
    <string name="help_location_title">Location chat</string>
    <string name="help_location_body">Menu → Location chat: public chat with people in your block, neighborhood or city, over the internet. Only the approximate area is shared.</string>
    <string name="help_tile_title">Tile</string>
    <string name="help_tile_body">Swipe left on the watch face, tap +, choose Skein: new messages, people nearby and Phone or Own radio at a glance.</string>
    <string name="help_complication_title">Complication</string>
    <string name="help_complication_body">Long-press the watch face → Edit → Complications → Skein messages for an unread count on your watch face.</string>
    <string name="help_privacy_title">Privacy</string>
    <string name="help_privacy_body">Nothing is stored on a server. Menu → Save history keeps private chats on this watch only; turn it off to erase them.</string>
    <string name="help_language_title">Language</string>
    <string name="help_language_body">The watch uses the same language as Skein on your phone. Change it in the phone app\'s settings.</string>
</resources>
